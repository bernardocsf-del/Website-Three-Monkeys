# Copie para .env.local (dev) ou configure como variáveis/segredos no Cloudflare.
WP_URL=https://threemonkeysbeer.com
SITE_URL=https://threemonkeysbeer.com
# Deixe vazio no ambiente de teste para não poluir o Analytics (produção: GTM-577TBXBB)
NEXT_PUBLIC_GTM_ID=
# "true" no ambiente de teste: impede indexação no Google
PUBLIC_NOINDEX=true
# Segredo do webhook de revalidação (configure como SECRET no Cloudflare, nunca no repositório)
REVALIDATE_SECRET=
