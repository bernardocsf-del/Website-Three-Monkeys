---
interface Props { only?: 'sobre' | 'evento'; }
const TILES = {
  sobre: {
    img: 'https://threemonkeysbeer.com/wp-content/uploads/2025/09/sobre-three-monkeys-website.png.webp',
    title: ['Cervejaria artesanal', 'com DNA carioca'],
    cta: 'Sobre nós',
    href: '/sobre/',
  },
  evento: {
    img: 'https://threemonkeysbeer.com/wp-content/uploads/2025/09/seu-evento-three-monkeys-website.png.webp',
    title: ['Leve a TMB', 'para seu evento'],
    cta: 'Saiba mais',
    href: '/chope-em-casa/',
  },
};
const { only } = Astro.props;
const list = only ? [TILES[only]] : [TILES.sobre, TILES.evento];
---
<section class="section promo">
  <div class:list={['container', 'grid', { single: list.length === 1 }]}>
    {list.map((t) => (
      <a class="tile" href={t.href}>
        <img src={t.img} alt="" loading="lazy" width="1200" height="1000" />
        <div class="body">
          <h4>{t.title[0]}<br />{t.title[1]}</h4>
          <span class="btn btn-dark">{t.cta}</span>
        </div>
      </a>
    ))}
  </div>
</section>
<style>
  .promo { background: var(--bg); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .grid.single { grid-template-columns: 1fr; }
  .tile { position: relative; display: block; overflow: hidden; }
  .tile img { width: 100%; height: 100%; aspect-ratio: 1.2; object-fit: cover; transition: transform .5s; }
  .single .tile img { aspect-ratio: 1.6; }
  .tile:hover img { transform: scale(1.04); }
  .tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, .65)); }
  .body { position: absolute; left: 30px; bottom: 30px; z-index: 1; }
  .body h4 { font-size: clamp(16px, 1.8vw, 22px); text-transform: uppercase; margin-bottom: 16px; line-height: 1.3; }
  @media (max-width: 767px) {
    .grid { grid-template-columns: 1fr; gap: 20px; }
    .body { left: 20px; bottom: 20px; }
  }
</style>
