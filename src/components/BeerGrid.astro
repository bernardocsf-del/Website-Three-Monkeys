---
interface Item { slug: string; name: string; format: string; image: string; imageAlt: string; seal: string | null; }
interface Props { items: Item[]; scroll?: boolean; }
const { items, scroll = false } = Astro.props;
---
<div class:list={['grade', { scroll, rail: scroll }]}>
  {items.map((b) => (
    <a href={`/cervejas/${b.slug}/`}>
      <span class="foto">
        {b.seal && <img class="selo" src={b.seal} alt="" aria-hidden="true" loading="lazy" />}
        <img class="prod" src={b.image} alt={b.imageAlt} width="1920" height="2362" loading="lazy" />
      </span>
      <h3>{b.name}</h3>
      <span class="vol">{b.format}</span>
    </a>
  ))}
</div>
<style>
  .grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 30px; }
  .grade a { display: block; text-align: center; position: relative; }
  .foto { display: block; position: relative; width: 72%; margin: 0 auto; }
  .prod { width: 100%; transition: transform .25s ease; }
  .grade a:hover .prod { transform: translateY(-8px); }
  .selo { position: absolute; top: 2%; left: -16%; width: 30%; z-index: 2; }
  h3 { font-size: 22px; font-weight: 800; text-transform: uppercase; color: var(--white); margin: 16px 0 4px; line-height: 1.15; }
  .vol { display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .18em; color: var(--gold); }
  .scroll { display: grid; grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - 60px) / 3); gap: 30px; padding-bottom: 16px; }
  @media (max-width: 1024px) {
    .grade { grid-template-columns: repeat(2, 1fr); }
    .scroll { grid-template-columns: none; grid-auto-columns: calc((100% - 30px) / 2); }
  }
  @media (max-width: 600px) {
    .grade { grid-template-columns: 1fr; }
    .scroll { grid-template-columns: none; grid-auto-columns: 80%; }
    h3 { font-size: 19px; }
    .foto { width: 64%; }
  }
</style>
