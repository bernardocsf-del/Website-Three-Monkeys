---
import Base from '../layouts/Base.astro';
import ProductRail from '../components/ProductRail.astro';
import ClubCta from '../components/ClubCta.astro';
import PromoTiles from '../components/PromoTiles.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import { ordered, HOME_ORDER } from '../lib/site';

const U = 'https://threemonkeysbeer.com/wp-content/uploads';
const slides = [
  { src: `${U}/2026/07/slider-home-azulejo-v6-pano.jpg.webp`, alt: 'Three Monkeys Beer — azulejos pretos, logotipo Motor Oil', w: 2560, h: 1250 },
  { src: `${U}/2026/07/slider-home-praia-pano.jpg.webp`, alt: "Latas I'm Sour na praia — Three Monkeys Beer", w: 2292, h: 1119 },
];
const cards = [
  { slug: 'im-sour', img: `${U}/2026/08/card-home-im-sour-v8-dark.png.webp`, alt: "I'm Sour — cerveja Sour 6,3% ABV da Three Monkeys Beer" },
  { slug: 'classic-ipa', img: `${U}/2026/08/card-home-classic-ipa-v7-dark.png.webp`, alt: 'Classic IPA — American IPA 6% ABV da Three Monkeys Beer' },
  { slug: 'golden-ale', img: `${U}/2026/08/card-home-golden-ale-v7-dark.png.webp`, alt: 'Golden Ale 7,5% ABV da Three Monkeys Beer' },
  { slug: 'hoppy-lager', img: `${U}/2026/08/card-home-hoppy-lager-v7-dark.png.webp`, alt: 'Hoppy Lager — American Lager 5% ABV da Three Monkeys Beer' },
  { slug: 'classic-ipa-free', img: `${U}/2026/08/card-home-classic-ipa-free-v7-dark.png.webp`, alt: 'Classic IPA Free — IPA sem álcool, até 0,5% ABV, da Three Monkeys Beer' },
  { slug: 'classic-ipa-summer', img: `${U}/2026/08/card-home-classic-ipa-summer-v7-dark.png.webp`, alt: 'Classic IPA Summer — Session IPA 3,3% ABV da Three Monkeys Beer' },
];
const products = ordered(HOME_ORDER);
---
<Base>
  <section class="hero" aria-label="Destaques" data-slider>
    <div class="slides">
      {slides.map((s, i) => (
        <img src={s.src} alt={s.alt} width={s.w} height={s.h} class:list={{ active: i === 0 }} fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
    </div>
    <div class="dots">
      {slides.map((_, i) => <button type="button" aria-label={`Slide ${i + 1}`} class:list={{ active: i === 0 }} data-i={i} />)}
    </div>
  </section>

  <section class="teaser">
    <div class="teaser-inner">
      <video autoplay loop muted playsinline preload="metadata" poster={`${U}/2026/07/Poster_teaser_Galaxy_Milky_Way_v2.jpg`}>
        <source src={`${U}/2026/07/Teaser_Galaxy_Detox_e_Milky_Way_v2_1_Cristo_selo_TM.mp4`} type="video/mp4" />
      </video>
      <div class="overlay">
        <span class="t1">Chegaram na atmosfera terrestre</span>
        <span class="t2">Galaxy Detox &amp; Milky Way IPA</span>
        <a class="cta" href="/store/">Compre agora!</a>
      </div>
    </div>
  </section>

  <section class="section beers">
    <div class="container"><a class="title-box" href="/cervejas/">Nossas cervejas</a></div>
    <div class="rail cards container" role="list">
      {cards.map((c) => (
        <a role="listitem" href={`/cervejas/${c.slug}/`}><img src={c.img} alt={c.alt} width="702" height="1202" loading="lazy" /></a>
      ))}
    </div>
  </section>

  <section class="section shop">
    <div class="container"><a class="title-box" href="/store/">Loja</a></div>
    <div class="shop-rail"><ProductRail products={products} label="Produtos da loja" /></div>
  </section>

  <ClubCta />
  <PromoTiles />
  <InstagramFeed />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const imgs = root.querySelectorAll('.slides img');
    const dots = root.querySelectorAll<HTMLButtonElement>('.dots button');
    let i = 0;
    const go = (n: number) => {
      imgs[i].classList.remove('active'); dots[i].classList.remove('active');
      i = (n + imgs.length) % imgs.length;
      imgs[i].classList.add('active'); dots[i].classList.add('active');
    };
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.i))));
    setInterval(() => go(i + 1), 6000);
  });
</script>

<style>
  .hero { position: relative; background: #111; overflow: hidden; }
  .slides { position: relative; aspect-ratio: 2292 / 1119; max-height: 100vh; }
  .slides img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1s; }
  .slides img.active { opacity: 1; }
  .dots { position: absolute; bottom: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 8px; }
  .dots button { width: 8px; height: 8px; border-radius: 50%; border: 0; padding: 0; background: rgba(255, 255, 255, .45); cursor: pointer; }
  .dots button.active { background: var(--white); }

  .teaser { padding: 30px 15px 0; }
  .teaser-inner { position: relative; max-width: 1600px; margin: 0 auto; }
  .teaser video { width: 100%; }
  .overlay {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; padding-top: 5.5%;
    text-align: center; pointer-events: none;
  }
  .t1 { font-weight: 700; letter-spacing: .32em; color: var(--white); font-size: clamp(13px, 2.1vw, 32px); text-shadow: 0 2px 14px rgba(0, 0, 0, .75); padding: 0 16px; text-transform: uppercase; }
  .t2 { margin-top: 10px; font-weight: 600; letter-spacing: .22em; color: var(--gold); font-size: clamp(11px, 1.4vw, 19px); text-shadow: 0 2px 10px rgba(0, 0, 0, .85); padding: 0 16px; text-transform: uppercase; }
  .cta {
    pointer-events: auto; margin-top: auto; margin-bottom: 7%; display: inline-block; padding: 14px 34px; border: 2px solid var(--gold);
    color: var(--gold); background: rgba(0, 0, 0, .28); font-weight: 700; letter-spacing: .18em; font-size: clamp(11px, 1.15vw, 16px);
    line-height: 1; text-transform: uppercase;
  }
  .cta:hover { background: var(--gold); color: #111; }

  .cards { grid-auto-columns: calc((100% - 2 * 20px) / 3); margin-top: 40px; }
  .cards img { width: 100%; }
  .cards a:hover img { transform: translateY(-6px); }
  .cards img { transition: transform .3s; }

  .shop { padding-top: 20px; }
  .shop-rail { margin-top: 40px; }

  @media (max-width: 767px) {
    .slides { aspect-ratio: 4 / 5; }
    .cta { padding: 10px 22px; letter-spacing: .14em; margin-bottom: 9%; }
    .cards { grid-auto-columns: 75%; }
  }
</style>
