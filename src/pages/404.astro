---
import Base from '../layouts/Base.astro';
---
<Base padded title="Página não encontrada | Three Monkeys Beer">
  <section class="container nf center">
    <p class="kicker">Erro 404</p>
    <h1>Essa página fugiu pro mato.</h1>
    <p>O endereço que você procurou não existe ou mudou de lugar.</p>
    <div class="actions">
      <a class="btn btn-gold" href="/">Voltar ao início</a>
      <a class="btn btn-outline" href="/store/">Ir para a loja</a>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 60px var(--gutter) 100px; }
  .nf h1 { font-size: clamp(28px, 4vw, 44px); }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
</style>
