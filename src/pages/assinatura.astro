---
import Base from '../layouts/Base.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import { wp } from '../lib/site';

const U = 'https://threemonkeysbeer.com/wp-content/uploads';
const ASSINAR = wp('/produto/memberchimp-club/');
const qtds = [
  { img: '12_unidades_assinatura.png.webp', alt: '12 unidades — ideal pra descobrir suas favoritas' },
  { img: '18_unidades_assinatura.png.webp', alt: '18 unidades — pra nunca faltar na geladeira' },
  { img: '24_unidades_assinatura.png.webp', alt: '24 unidades — pra quem gosta de receber os amigos' },
];
const selecao = [
  ['lf-classic-ipa-dark-v2.png.webp', 'Classic IPA garrafa 500ml'],
  ['lf-free-dark-v2.png.webp', 'Classic IPA Free lata 350ml'],
  ['lf-summer-dark-v2.png.webp', 'Classic IPA Summer lata 350ml'],
  ['lf-golden-ale-dark-v2.png.webp', 'Golden Ale garrafa 500ml'],
  ['lf-hoppy-lager-dark-v2.png.webp', 'Hoppy Lager garrafa 500ml'],
  ['lf-im-sour-dark-v2.png.webp', "I'm Sour lata 473ml"],
];
const beneficios = [
  ['Praticidade', 'Receba em casa, com regularidade e qualidade.'],
  ['Explore<br>sabores únicos', 'Cervejas que desafiam o convencional.'],
  ['Presenteie<br>ou mime-se', 'Um mimo perfeito para quem adora cerveja artesanal.'],
  ['Exclusividade', 'Cupons exclusivos e preço especial para lançamentos e sazonais.'],
];
---
<Base>
  <section class="hero" style={`background-image:url(${U}/2025/10/banner-clube-tmb-05.jpg)`}>
    <div class="container center">
      <img class="badge" src={`${U}/2025/10/1-TM_MemberChimp.png.webp`} alt="Three Monkeys Beer MemberChimp" />
      <h1>Cervejas Artesanais da Three Monkeys Beer Direto na Sua Casa!</h1>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <div class="txt">
        <h2 class="club-name">MemberChimp Club</h2>
        <p class="sub">Cervejas Artesanais da Three Monkeys Beer Direto na Sua Casa!</p>
        <p>Para quem ama cerveja com personalidade, apresentamos o <strong>MemberChimp Club</strong> – um clube de assinatura criado para levar até você as cervejas mais saborosas da <strong>Three Monkeys</strong>, uma das cervejarias artesanais mais inovadoras do Brasil.</p>
        <p>Escolha sua assinatura e receba em casa uma seleção das nossas <strong>cervejas premium</strong>, e fique tranquilo, com a geladeira abastecida – sempre com aquele toque irreverente e experimental que só a Three Monkeys tem.</p>
      </div>
      <div class="center">
        <p class="pitch">Three Monkeys Beer MemberChimp Club – Cervejas Artesanais com Atitude Direto na Sua Casa!</p>
        <a class="btn btn-gold btn-lg big" href={ASSINAR}>Assine já o clube!</a>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="container">
      <h2 class="how">Como funciona?</h2>
      <p class="step">Escolha a quantidade</p>
      <p class="step-sub">Você escolhe a quantidade e a frequência que melhor se adapta ao seu ritmo</p>
      <div class="qtds">
        {qtds.map((q) => <img src={`${U}/2026/07/${q.img}`} alt={q.alt} loading="lazy" />)}
      </div>
      <p class="step-sub">Você também pode escolher a frequência</p>
      <div class="freq"><span>Mensal</span><span>Bimestral</span></div>
      <p class="step">Receba em casa</p>
      <p class="step-sub">Receba nossa seleção de cervejas</p>
    </div>
    <div class="rail selecao">
      {selecao.map(([img, alt]) => <img src={`${U}/2026/08/${img}`} alt={alt} loading="lazy" />)}
    </div>
  </section>

  <section class="beneficios">
    <div class="container grid4">
      {beneficios.map(([t, d]) => (
        <div><h3 set:html={t} /><p>{d}</p></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <p class="closing">Não perca tempo – Garanta sua assinatura e descubra por que a Three Monkeys é pura irreverência em forma de cerveja!</p>
      <div class="center">
        <p class="pitch small">Para finalizar, escolha a forma de pagamento e preencha todos os dados</p>
        <a class="btn btn-gold btn-lg big" href={ASSINAR}>Assine já o clube!</a>
      </div>
    </div>
  </section>

  <InstagramFeed />
</Base>

<style>
  .hero { min-height: 760px; background: #2a2414 center / cover no-repeat; display: flex; align-items: center; padding-top: 140px; }
  .badge { width: 300px; margin: 0 auto 30px; }
  .hero h1 { font-size: clamp(20px, 2.4vw, 30px); text-shadow: 0 2px 12px rgba(0, 0, 0, .6); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .club-name { font-size: 40px; text-transform: uppercase; margin-bottom: 14px; }
  .sub { font-size: 30px; font-weight: 300; color: var(--white); line-height: 1.2; }
  .txt { color: var(--white); font-size: 15px; line-height: 1.75; }
  .txt strong { color: var(--white); }
  .pitch { color: var(--white); font-size: 26px; font-weight: 600; line-height: 1.4; }
  .pitch.small { font-size: 22px; font-weight: 400; }
  .big { font-size: 22px; font-weight: 700; padding: 10px 26px; }
  .how { font-size: clamp(32px, 4vw, 50px); text-transform: uppercase; margin-bottom: 40px; }
  .step { color: var(--gold); font-size: 22px; font-weight: 700; text-transform: uppercase; margin: 30px 0 10px; }
  .step-sub { color: var(--white); font-size: clamp(20px, 2.2vw, 30px); font-weight: 300; line-height: 1.3; max-width: 760px; margin: 0 auto 30px; }
  .qtds { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; max-width: 1050px; margin: 0 auto 60px; }
  .freq { display: flex; justify-content: center; gap: 120px; color: var(--gold); font-size: 22px; font-weight: 700; text-transform: uppercase; margin-bottom: 60px; }
  .selecao { grid-auto-columns: calc((100% - 4 * 20px) / 4.5); gap: 20px; margin-top: 10px; }
  .selecao img { width: 100%; }
  .beneficios { background: var(--bg-black); padding: 60px 0; }
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
  .grid4 h3 { font-size: 22px; text-transform: uppercase; }
  .grid4 p { color: var(--white); font-size: 15px; }
  .closing { color: var(--white); font-size: clamp(22px, 2.6vw, 34px); font-weight: 300; text-align: center; line-height: 1.3; }
  @media (max-width: 900px) {
    .two { grid-template-columns: 1fr; gap: 30px; }
    .grid4 { grid-template-columns: 1fr 1fr; }
    .qtds { grid-template-columns: 1fr; max-width: 360px; }
    .selecao { grid-auto-columns: 70%; }
    .freq { gap: 50px; }
    .hero { min-height: 560px; }
    .badge { width: 220px; }
  }
</style>
